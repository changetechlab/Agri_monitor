# =============================================================
# Agri Monitor — CHANGE TechLab
# Environment Variables Template
# =============================================================
# Copy this file to .env for local development ONLY.
# For production: add these variables in the Vercel dashboard:
#   Settings -> Environment Variables
#
# SECURITY:
#   .env is gitignored and must NEVER be committed.
#   Secrets must NEVER appear in config.js, index.html, or any JS file.
# =============================================================

# ─── GEE SERVICE ACCOUNT (Vercel Serverless Function) ────────
# Required for /api/gee-tiles to authenticate with Google Earth Engine.
# Create at: https://console.cloud.google.com/iam-admin/serviceaccounts
# Project: change-krishi-bot
# Register SA at: https://code.earthengine.google.com -> Assets -> Service Accounts
#
# Example value: agrimonitor@change-krishi-bot.iam.gserviceaccount.com
GEE_SERVICE_ACCOUNT_EMAIL=your-service-account@change-krishi-bot.iam.gserviceaccount.com

# The private_key field from the downloaded service account JSON key file.
# Paste the entire -----BEGIN RSA PRIVATE KEY----- ... -----END RSA PRIVATE KEY----- block.
# Vercel encodes newlines as \n automatically — paste as-is.
GEE_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END RSA PRIVATE KEY-----

# ─── SUPABASE (Optional — for real field data storage) ────────
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key-here

# ─── APP ──────────────────────────────────────────────────────
APP_ENV=production
APP_VERSION=1.0.0
PILOT_DISTRICT=rudraprayag
